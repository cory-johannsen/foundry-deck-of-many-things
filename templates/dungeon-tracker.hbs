{{#if hasScene}}
  {{#if hasRun}}
    <div class="dommt-dungeon">
      <div class="dommt-dungeon__progress">
        {{#if completed}}
          {{localize "DOMMT.Dungeon.Completed"}}
        {{else}}
          {{#if isSafeRoom}}
            {{currentRoom.kindLabel}}
          {{else}}
            {{localize
              "DOMMT.Dungeon.ProgressLabel"
              n=roomNumber
              total=roomTotal
            }}
          {{/if}}
        {{/if}}
      </div>

      {{#if currentRoom}}
        <div class="dommt-dungeon__room">
          {{#if currentRoom.isGoal}}
            <strong>{{localize "DOMMT.Dungeon.Kind.goal"}}</strong>
          {{else}}
            <strong>{{currentRoom.kindLabel}}</strong>
          {{/if}}

          {{#if currentRoom.setpiece}}
            <p
              class="dommt-dungeon__setpiece-name"
            >{{currentRoom.setpiece.name}}</p>
            <p>{{currentRoom.setpiece.summary}}</p>
          {{/if}}
        </div>
      {{/if}}

      {{#unless completed}}
        <p class="hint">{{localize
            "DOMMT.Dungeon.ThemeReminder"
            traits=traits
            excludeTraits=excludeTraits
          }}</p>
        {{#if isSafeRoom}}
          {{#unless nextRoomPending}}
            {{#if isSafeEntry}}
              <p class="hint">{{localize "DOMMT.Dungeon.SafeEntryHint"}}</p>
            {{else}}
              <p class="hint">{{localize "DOMMT.Dungeon.SafeRestHint"}}</p>
            {{/if}}
          {{/unless}}
        {{else}}
          {{#if isCombatRoom}}
            {{#if combatActive}}
              <p class="hint">{{localize
                  "DOMMT.Dungeon.Combat.InProgressHint"
                }}</p>
              <footer>
                <button type="button" data-action="openCombatTracker">{{localize
                    "DOMMT.Dungeon.Combat.OpenTrackerButton"
                  }}</button>
                <button type="button" data-action="declareVictory">{{localize
                    "DOMMT.Dungeon.Combat.DeclareVictoryButton"
                  }}</button>
                <button type="button" data-action="declareDefeat">{{localize
                    "DOMMT.Dungeon.Combat.DeclareDefeatButton"
                  }}</button>
              </footer>
            {{/if}}
            {{#if combatMissing}}
              <footer>
                <button
                  type="button"
                  data-action="startCombatRecovery"
                >{{localize "DOMMT.Dungeon.Combat.StartCombatButton"}}</button>
              </footer>
            {{/if}}
          {{else if isSkillChallenge}}
            <div class="dommt-dungeon__skill-challenge">
              <p>{{localize
                  "DOMMT.Dungeon.SkillChallenge.Progress"
                  vp=challenge.vp
                  target=challenge.vpTarget
                }}</p>
              <p class="hint">{{localize
                  "DOMMT.Dungeon.SkillChallenge.AttemptsRemaining"
                  n=challenge.attemptsRemaining
                }}</p>
              <p class="hint">
                {{localize "DOMMT.Dungeon.SkillChallenge.SpecialtyHint"}}
                {{#each challenge.specialtySkills}}{{this.label}}{{#unless
                    @last
                  }}, {{/unless}}{{/each}}
              </p>
              <form class="dommt-dungeon__skill-challenge-form">
                <label>
                  {{localize "DOMMT.Dungeon.SkillChallenge.WhoLabel"}}
                  <select name="actorId">
                    {{#each partyMembers}}
                      <option value="{{this.id}}">{{this.name}}</option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  {{localize "DOMMT.Dungeon.SkillChallenge.SkillLabel"}}
                  <select name="skill">
                    {{#each challenge.allSkills}}
                      <option value="{{this.slug}}">{{this.label}}{{#if
                          this.isSpecialty
                        }} *{{/if}}</option>
                    {{/each}}
                  </select>
                </label>
                <button
                  type="button"
                  data-action="attemptSkillChallenge"
                >{{localize
                    "DOMMT.Dungeon.SkillChallenge.AttemptButton"
                  }}</button>
              </form>
            </div>
          {{else}}
            {{#unless currentRoomResolved}}
              <footer>
                <button type="button" data-action="succeed">{{localize
                    "DOMMT.Dungeon.SucceedButton"
                  }}</button>
                <button type="button" data-action="fail">{{localize
                    "DOMMT.Dungeon.FailButton"
                  }}</button>
              </footer>
            {{/unless}}
          {{/if}}
        {{/if}}
        {{#if nextRoomPending}}
          <p class="hint">{{localize "DOMMT.Dungeon.DoorLockedHint"}}</p>
          <footer>
            <button type="button" data-action="populateNext">{{localize
                "DOMMT.Dungeon.PopulateNextButton"
              }}</button>
          </footer>
        {{/if}}
        {{#if canUndo}}
          <footer>
            <button type="button" data-action="undo">{{localize
                "DOMMT.Dungeon.UndoButton"
              }}</button>
          </footer>
        {{/if}}
      {{/unless}}

      {{#if history.length}}
        <div class="dommt-dungeon__history">
          {{#each history}}
            <div class="dommt-dungeon__history-entry">
              <span
                class="dommt-dungeon__history-outcome"
              >{{this.outcomeLabel}}</span>
              <span>{{this.effectLabel}}</span>
            </div>
          {{/each}}
        </div>
      {{/if}}

      <footer>
        <button type="button" data-action="hide">{{localize
            "DOMMT.Dungeon.HideButton"
          }}</button>
        <button type="button" data-action="abandon">{{localize
            "DOMMT.Dungeon.AbandonButton"
          }}</button>
      </footer>
    </div>
  {{else}}
    <form class="dommt-dungeon">
      <label>
        {{localize "DOMMT.Dungeon.RoomCountLabel"}}
        <input
          type="number"
          name="roomCount"
          min="2"
          max="20"
          value="{{defaultRoomCount}}"
        />
      </label>
      {{{traitsFieldHtml}}}
      {{{excludeTraitsFieldHtml}}}
      <footer>
        <button type="button" data-action="start">{{localize
            "DOMMT.Dungeon.StartButton"
          }}</button>
      </footer>
    </form>
  {{/if}}
{{else}}
  <p class="hint">{{localize "DOMMT.Dungeon.NoSceneWarning"}}</p>
{{/if}}