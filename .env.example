# Foundry REST API relay — point this at a self-hosted
# ThreeHats/foundryvtt-rest-api-relay instance (unlimited requests) rather than
# the public foundryrestapi.com (100 req/mo free tier), which can't sustain
# continuous polling. NOT required to build or ship the module.
FOUNDRY_BASE_URL=
FOUNDRY_REST_API_KEY=

# ComfyUI server (art generation). Override if not using the default.
COMFYUI_BASE_URL=https://comfyui.example.com

# Google Gemini API (generativelanguage.googleapis.com) — fallback for card art
# generation if ComfyUI proves insufficient. Auth via X-goog-api-key header.
GEMINI_API_KEY=
