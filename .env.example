# Foundry REST API (foundryrestapi.com) — used by tools that push state to the running world.
# NOT required to build or ship the module.
FOUNDRY_REST_API_KEY=

# ComfyUI server (art generation). Override if not using the default.
COMFYUI_BASE_URL=https://comfyui.example.com

# Google Gemini API (generativelanguage.googleapis.com) — fallback for card art
# generation if ComfyUI proves insufficient. Auth via X-goog-api-key header.
GEMINI_API_KEY=
