node_modules/
.env
.env.local
.DS_Store
*.log
.idea/
coverage/
.vitest-cache/

# Foundry compendium build artifacts (LevelDB) — regenerated by tools/build-pack.mjs
packs/*/000*.log
packs/*/CURRENT
packs/*/LOCK
packs/*/LOG
packs/*/LOG.old
packs/*/MANIFEST-*
packs/*/*.ldb

# ComfyUI intermediate artifacts
tools/.comfyui-cache/

# Hardcopy photos + OCR transcription — scratch input for the one-time
# divination text import, completed in v0.2.0. data/cards.json is the source
# of truth for that text. Kept so re-shot pages never land in a commit.
card-text-images/

# Previous card art kept automatically before each --force regeneration
assets/.card-history/

# Review contact sheet - regenerate with tools/contact_sheet.py
docs/card-contact-sheet.html

# Raw sound downloads (Kenney, Freesound, …). Import them with
# tools/import-sound.mjs, which writes the trimmed ogg into assets/sounds/.
/*.wav
/*.mp3
/*.aiff
/*.aif
/*.flac
